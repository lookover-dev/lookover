---
// Starlight's head, plus the site's styles: the app's fonts and tokens (Fonts), then Starlight on them (site.css).
// Imported here, in the frontmatter, rather than through Starlight's `customCss`, so knip sees the packages the site
// uses (it doesn't read imports inside CSS).
import Fonts from "./Fonts.astro";
import "../brand/eyes.generated.css";
import "../styles/header.css";
import "../styles/site.css";
import Default from "@astrojs/starlight/components/Head.astro";
---

<Default><slot /></Default>
<Fonts />

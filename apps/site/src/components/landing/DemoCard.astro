---
// S2's review loop condensed into one card for the site, in GitHub's colours, as the shared App posts it (ADR 0065,
// ADR 0074): Lookover's status block at the end of the description, the review by the person signed in with no body
// and its line comment, each post opening with the wordmark, the check under Lookover. The caption makes clear that
// this groups the separate GitHub posts. The person is an example.
import { ICON } from "../../brand/eyes.generated.ts";

const PERSON = "mira";
const INITIAL = PERSON.charAt(0).toUpperCase();
---

<section class="demo">
  <div class="wrap">
    <div class="pr gh">
      <div class="pr-head">
        <div class="pr-title">Add rate limiting to /v1/invoices <span class="num">#148</span></div>
        <div class="pr-meta">
          <span class="state">Open</span><span
            >agent wants to merge <code>add-rate-limit</code> into <code>main</code> · 4 files changed</span
          >
        </div>
      </div>
      <div class="pr-body">
        <div class="cm">
          <span class="av" aria-hidden="true">A</span>
          <div class="cm-box">
            <div class="cm-h"><b>agent</b> <span>commented</span></div>
            <div class="cm-b">
              <p>Limits each API key to 100 requests a minute on /v1/invoices.</p>
              <hr />
              <p class="block-head">
                <img
                  class="wm on-dark"
                  src="/brand/lookover-wordmark-on-dark.svg"
                  width="86"
                  height="26"
                  alt="Lookover"
                /><img class="wm on-light" src="/brand/lookover-wordmark.svg" width="86" height="26" alt="Lookover" />
                · Nothing to fix
              </p>
              <p class="block-line">Round 2 · <code>b2c3d4e</code> · 1 fixed</p>
            </div>
          </div>
        </div>
        <div class="cm">
          <span class="av" aria-hidden="true">{INITIAL}</span>
          <div class="cm-box">
            <div class="cm-h"><b>{PERSON}</b> <span>commented on <code>a1f9c2e</code></span></div>
            <div class="diff">
              <div class="file">src/middleware/rateLimit.ts</div>
              <div class="ln"><span>41</span><span>if (limited) &#123;</span></div>
              <div class="ln hl">
                <span>42</span><span>  log.warn("throttled", &#123; headers: req.headers &#125;);</span>
              </div>
              <div class="ln"><span>43</span><span>  return res.status(429).end();</span></div>
            </div>
            <div class="cm-b">
              <p>
                <img
                  class="wm on-dark"
                  src="/brand/lookover-wordmark-on-dark.svg"
                  width="60"
                  height="18"
                  alt="Lookover"
                /><img class="wm on-light" src="/brand/lookover-wordmark.svg" width="60" height="18" alt="Lookover" />
                · Blocking
              </p>
              <p>
                <b>API key is written to the request log</b>
              </p>
              <p>When a client is throttled, the full headers are logged, including Authorization. Log the client id instead.</p>
            </div>
            <div class="thread">
              <span><b>agent</b> · Fixed in <code>b2c3d4e</code>: logs the key id only.</span>
              <span><span class="ok">Resolved</span> · verified fixed in <code>b2c3d4e</code></span>
            </div>
          </div>
        </div>
        <div class="check">
          <span class="ico" aria-hidden="true"><Fragment set:html={ICON} /></span><b>Lookover</b><span
            ><span class="ok">Nothing to fix</span> · <code>b2c3d4e</code></span
          >
        </div>
      </div>
    </div>
    <p class="cap">
      One pull request, two rounds, condensed. Lookover keeps its status at the end of the description and posts its
      findings as you; the check shows under Lookover.
    </p>
  </div>
</section>

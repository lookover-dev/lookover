---
// S2's review loop condensed into one card for the site, in GitHub's colours. The caption makes clear that this
// groups the separate GitHub posts. The App's display name is illustrative; installations have unique slugs.
import { ICON } from "../../brand/eyes.generated.ts";

const APP = "lookover";
---

<section class="demo">
  <div class="wrap">
    <div class="pr gh">
      <div class="pr-head">
        <div class="pr-title">Add rate limiting to /v1/invoices <span class="num">#148</span></div>
        <div class="pr-meta">
          <span class="state">Open</span><span
            >agent wants to merge <code>add-rate-limit</code> into <code>main</code> · 4 files changed</span
          >
        </div>
      </div>
      <div class="pr-body">
        <div class="cm">
          <span class="av"><Fragment set:html={ICON} /></span>
          <div class="cm-box">
            <div class="cm-h"><b>{APP}</b> <span class="bot">bot</span> <span>reviewed <code>a1f9c2e</code> · round 1</span></div>
            <div class="cm-b">
              <p>
                <b>One thing to fix.</b> The rest can go.
              </p>
              <p class="found-by">Found by Codex, double-checked by Claude.</p>
            </div>
            <div class="diff">
              <div class="file">src/middleware/rateLimit.ts</div>
              <div class="ln"><span>41</span><span>if (limited) &#123;</span></div>
              <div class="ln hl">
                <span>42</span><span>  log.warn("throttled", &#123; headers: req.headers &#125;);</span>
              </div>
              <div class="ln"><span>43</span><span>  return res.status(429).end();</span></div>
            </div>
            <div class="cm-b">
              <span class="sev">Blocking</span>
              <p>
                <b>API key is written to the request log.</b> When a client is throttled, the full headers are logged,
                including Authorization. Log the client id instead.
              </p>
            </div>
            <div class="thread">
              <span><b>agent</b> · Fixed in <code>b2c3d4e</code>: logs the key id only.</span>
              <span><span class="ok">Resolved</span> · verified fixed in <code>b2c3d4e</code></span>
            </div>
            <div class="check">
              <span class="dot" aria-hidden="true"></span><span><b>Nothing to fix.</b> Checked <code>b2c3d4e</code> · round 2</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="cap">
      One pull request, two rounds. A condensed preview of the review, the fix and the passing check on GitHub.
    </p>
  </div>
</section>

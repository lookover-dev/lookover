---
// The demo card: the loop in one pull request, drawn as GitHub shows it, in GitHub's colours and type (`.gh`,
// github-colours.css), following the page's theme. Lookover's avatar is the icon file; the App posts as itself, under
// the name "Create your App" gives it (`lookover-` and six characters). Its words are the ones Lookover posts: the
// review's top comment, the summary comment with who found and who double-checked, the finding on its line, then the
// thread resolved once the fix is verified (Lookover posts no reply on a fixed thread), and the check's title. The
// names (ledger-api, #148, the commits) are demo mode's, shortened.
import { ICON } from "../../brand/eyes.generated.ts";

const APP = "lookover-q7x2ka";
---

<section class="demo">
  <div class="wrap">
    <div class="pr gh">
      <div class="pr-head">
        <div class="pr-title">Add rate limiting to /v1/invoices <span class="num">#148</span></div>
        <div class="pr-meta">
          <span class="state">Open</span><span
            >agent wants to merge <code>add-rate-limit</code> into <code>main</code> · 4 files changed</span
          >
        </div>
      </div>
      <div class="pr-body">
        <div class="cm">
          <span class="av"><Fragment set:html={ICON} /></span>
          <div class="cm-box">
            <div class="cm-h"><b>{APP}</b> <span class="bot">bot</span> reviewed</div>
            <div class="cm-b">
              <p>
                Looked over a1f9c2e. One thing to fix, rateLimit.ts line 42. The rest can go.
              </p>
            </div>
          </div>
        </div>
        <div class="cm">
          <span class="av"><Fragment set:html={ICON} /></span>
          <div class="cm-box">
            <div class="cm-h"><b>{APP}</b> <span class="bot">bot</span> commented</div>
            <div class="cm-b">
              <p><b>Lookover</b> · round 1 · looked over a1f9c2e</p>
              <p class="found-by">Found by Codex, double-checked by Claude.</p>
              <p>One thing to fix, rateLimit.ts line 42.</p>
            </div>
          </div>
        </div>
        <div class="cm">
          <span class="av"><Fragment set:html={ICON} /></span>
          <div class="cm-box">
            <div class="cm-h">
              <b>{APP}</b> <span class="bot">bot</span> commented on <code>src/middleware/rateLimit.ts</code>
            </div>
            <div class="diff">
              <div class="file">src/middleware/rateLimit.ts</div>
              <div class="ln"><span>41</span><span>if (limited) &#123;</span></div>
              <div class="ln hl">
                <span>42</span><span>  log.warn("throttled", &#123; headers: req.headers &#125;);</span>
              </div>
              <div class="ln"><span>43</span><span>  return res.status(429).end();</span></div>
            </div>
            <div class="cm-b">
              <span class="sev">Blocking</span>
              <p>
                <b>API key is written to the request log.</b> When a client is throttled, the full headers are logged,
                including Authorization. Log the client id instead.
              </p>
            </div>
            <div class="thread">
              <span><b>agent</b> · Fixed in <code>b2c3d4e</code>: logs the key id only.</span>
              <span><span class="ok">Resolved</span> · verified fixed in <code>b2c3d4e</code></span>
            </div>
          </div>
        </div>
        <div class="check">
          <span class="dot"></span><b>Lookover</b><span>Looked over b2c3d4e: nothing to fix</span><span class="r"
            >Details</span
          >
        </div>
      </div>
    </div>
    <p class="cap">
      One pull request, two rounds: the finding, the fix, the check. Posted by your own GitHub App, as itself.
    </p>
  </div>
</section>

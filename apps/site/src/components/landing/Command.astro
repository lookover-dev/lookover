---
// The install command alone; the setup section explains the first start.
import { COMMANDS } from "../../landing/facts.ts";

const install = COMMANDS[0];
---

<div class="cmd">
  <span class="lines">
    <span class="line"><span class="dollar" aria-hidden="true">$</span>{install}</span>
  </span>
  <button type="button" class="copy" data-copy={install} aria-label="Copy install command" title="Copy install command">
    <svg class="ready" viewBox="0 0 16 16" aria-hidden="true">
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
      <path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"></path>
    </svg>
    <svg class="done" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7"></path></svg>
  </button>
</div>
